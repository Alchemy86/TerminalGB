# Built-in battle presets for the `gen1-battle` plugin.
#
# This file is compiled into the binary so that "one keypress" works before
# anyone has written a preset file of their own. Copy it to
#   ${XDG_CONFIG_HOME:-~/.config}/terminalgb/battles.preset
# and edit freely; a file on disk replaces this list entirely.
#
# Format: `[name]` starts a preset. `player =`, `wild =` and `enemy =` each
# start a Pokémon, and every key after one of those lines describes it.
# See docs/gen1/battle-control.md.

# ---------------------------------------------------------------------------
# The captain's example: a Charizard flamethrowering a Pidgey, as a clip.
#
# Nothing here is left to the dice, and that is deliberate — see
# docs/gen1/battle-control.md "Making a cinematic reproducible". A level 50 Charizard
# out-speeds a level 3 Pidgey by fifteen times and out-damages its whole HP bar
# by forty, so no damage roll, critical hit or turn order can change what the
# viewer sees. The seed pins the one thing that *could*: Gen 1's accuracy check
# gives even a 100%-accuracy move a 1-in-256 miss.
# ---------------------------------------------------------------------------
[charizard-flamethrower]
description = Charizard flamethrowers a Pidgey

player   = Charizard
level    = 50
moves    = Flamethrower, Slash, Fly, Earthquake
nickname = CHARIZARD
dvs      = 15, 15, 15, 15

wild     = Pidgey
level    = 3
dvs      = 5, 5, 5, 5

seed     = 0x1234

# Every step is driven by what is on screen, never by a frame count — see
# docs/gen1/reading-the-screen.md. Note the button choices: A opens the move
# list and selects the move, B advances the messages afterwards. B before the
# move is chosen would back out of the menu instead.
do = await-battle 400
do = press-until b FIGHT 900
do = press-until a FLAMETHROWER 300
do = press-until a "used FLAMETHROWER" 400
do = press-until b fainted 900
do = press-until b gained 900
do = mash b 8
do = await-overworld 900

# ---------------------------------------------------------------------------
# The same fight without the cinematic: set it up, hand control back.
# This is the shape to copy for "I want to be *in* this battle".
# ---------------------------------------------------------------------------
[charizard-vs-pidgey]
description = Charizard vs Pidgey, played by hand

player   = Charizard
level    = 50
moves    = Flamethrower, Slash, Fly, Earthquake
nickname = CHARIZARD

wild     = Pidgey
level    = 3

# ---------------------------------------------------------------------------
# A wild legendary, with the party left completely alone: no `player =` line,
# so this one is safe to fire at any save without changing anything that
# survives the battle.
# ---------------------------------------------------------------------------
[wild-mewtwo]
description = A level 70 Mewtwo appears, with your own party

wild     = Mewtwo
level    = 70

# ---------------------------------------------------------------------------
# A real trainer, fought with the roster the cartridge gives them.
# `roster` is the game's own wTrainerNo: 1 is the first party listed for the
# class in data/trainers/parties.asm.
# ---------------------------------------------------------------------------
[gym-brock]
description = Brock, exactly as the cartridge has him

# Brock's own roster comes from data/trainers/parties.asm; only the challenger
# is ours. A preset that names no `player` fights with whatever party the save
# already has — which is refused outright if the save has none, because a
# battle with an empty party is an instant black-out that looks like a crash.
player   = Squirtle
level    = 12
moves    = Bubble, Tackle, Tail Whip

trainer  = BROCK
roster   = 1

# ---------------------------------------------------------------------------
# A trainer whose team we replace outright. The class still supplies the
# sprite, the name, the music, the AI and the prize money; only the six
# Pokémon change.
# ---------------------------------------------------------------------------
[rival-charizard]
description = Your rival, if he had raised a Charizard

player   = Blastoise
level    = 60
moves    = Surf, Ice Beam, Body Slam, Rest
player   = Snorlax
level    = 58
moves    = Body Slam, Amnesia, Rest, Earthquake

trainer  = RIVAL3
roster   = 1

enemy    = Charizard
level    = 60
moves    = Fire Blast, Slash, Earthquake, Swords Dance
enemy    = Alakazam
level    = 58
moves    = Psychic, Recover, Thunder Wave, Seismic Toss
